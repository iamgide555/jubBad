# Secret used to sign the session cookie. The API refuses to start without
# it — an unset secret must not silently mean every signed cookie read fails.
# Generate one with:
#   openssl rand -base64 32
# Changing it signs every browser out for every user at once — the coarse,
# emergency-only revocation. Disabling one user (admin console) is per-user
# and does not require this.
SESSION_SECRET=

# Seeds the first admin account on the first boot only — read only when no
# admin exists yet, so both are safe to remove from the environment once
# that account exists. Change the password from the admin console rather
# than leaving a working one sitting in this file indefinitely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DATABASE_URL="file:./prisma/dev.db"

# Comma-separated list of allowed origins for CORS. Leave unset (or blank)
# for permissive CORS — the local dev default. Under NODE_ENV=production
# (which server/Dockerfile sets) unset means "no cross-origin caller at all"
# rather than "any origin", because production is served
# same-origin through nginx, so that costs nothing. Set the real origin if a
# browser ever needs to call the API cross-origin,
# e.g. CORS_ORIGINS=https://jubbad.wongnok.dev
CORS_ORIGINS=

# Where a free host is sent to upgrade: shown in the app's upgrade sheet and notices.
# Must be an https:// link (for example your LINE OA); anything else, or unset, shows
# the contact as plain text with no link.
UPGRADE_CONTACT_URL=

# LINE bot (paid feature): the shared JubBad Messaging API channel. Unset = the
# feature reports "not configured" and the webhook answers 503.
# Channel secret, used to verify the signature on every webhook call.
LINE_CHANNEL_SECRET=
# Channel access token, used to reply and to look up group and member names.
LINE_CHANNEL_ACCESS_TOKEN=
# The bot's https add-friend link, shown to hosts as the "add the bot" button.
LINE_BOT_ADD_URL=
