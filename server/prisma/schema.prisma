datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Group {
  code      String    @id
  name      String?
  createdAt DateTime  @default(now())
  /// Nullable by necessity, not by design: this column cannot be backfilled in
  /// the migration itself, because the admin account it points at does not
  /// exist until password hashing runs in application code. AuthBootstrapService
  /// fills every null on every boot, so in a running app this is never actually
  /// null — a future reader should not "fix" this to NOT NULL, which would
  /// break a fresh deploy before the first boot has run.
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id])
  players   Player[]
  sessions  Session[]
  sessionCreations SessionCreation[]
  playerRules PlayerRule[]
  /// Advanced host tools (numbered reusable shuttles and early checkout, D/E).
  /// Owner-editable, default off; copied to Session.shuttleToolsEnabled when a
  /// session is created, so flipping it only ever affects future sessions.
  shuttleToolsEnabled Boolean @default(false)
  /// Whether partner/opponent history spans every session the group has played
  /// (true) or only the current one (false, the default). Snapshotted onto
  /// Session.crossSessionHistory at creation, same as shuttleToolsEnabled.
  crossSessionHistory Boolean @default(false)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// 'admin' sees and manages every user and group; 'host' sees only the
  /// groups they own. See OwnershipGuard and the /admin module.
  role         String   @default("host")
  disabled     Boolean  @default(false)
  /// Bumped on disable, password change and password reset. The session
  /// cookie carries the version it was issued at; a mismatch is a 401. This is
  /// what makes revocation per-user instead of all-or-nothing — without it a
  /// disabled user's phone would keep working for the cookie's full 30 days.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  groups       Group[]
  resets       PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token, never the token itself — the raw value travels
  /// through a LINE chat by hand and lives in that scrollback indefinitely,
  /// the same reasoning that keeps passwords hashed rather than stored plain.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Records that a locked-out host asked for a reset, from the one page they
/// can still reach with no cookie at all. Deliberately inert: it grants
/// nothing by itself, and never reveals whether the email belongs to an
/// account — see AuthController#forgotPassword. An admin turns a request into
/// an actual PasswordReset by hand.
model PasswordResetRequest {
  id        String    @id @default(cuid())
  /// The email as typed, not a User relation: the request is recorded whether
  /// or not it matches an account, so a host's own typo is still visible to
  /// the admin rather than silently discarded.
  email     String
  createdAt DateTime  @default(now())
  handledAt DateTime?
  /// The handling admin's id as a plain string, not a relation, so this
  /// remains legible after that admin's own account is deleted.
  handledBy String?
}

model Player {
  id      String @id @default(cuid())
  groupId String
  name    String
  aliases String // JSON-encoded string[]
  age     Int?
  email   String?
  phone   String?
  /// Skill level (ระดับมือ): one of engines/levels.ts's LEVELS, or null when
  /// unset. Seeds this player's starting Elo (see engines/levels.ts seedFor)
  /// and is compared under the ±1 band when Session.mode is 'level'.
  /// Host-only — never included in a @Public response.
  level      String?
  /// When this level last changed. `null` means "from the start" for a
  /// legacy row or a level set before the player's first match.
  levelSetAt DateTime?
  group      Group  @relation(fields: [groupId], references: [code])
  rosterEntries SessionRoster[]
  waitlistEntries Waitlist[]
  rulesAsA   PlayerRule[] @relation("PlayerRuleA")
  rulesAsB   PlayerRule[] @relation("PlayerRuleB")
  checkouts SessionCheckout[]
}

model Session {
  code          String          @id
  groupId       String
  date          String?
  venue         String?
  courtCount    Int?
  rawImportText String
  createdAt     DateTime        @default(now())
  endedAt       DateTime?
  /// 'variety' (default) spreads partners and opponents; 'balanced' also
  /// pulls the two sides of each match together on Elo rating; 'level'
  /// spreads partners like 'variety' but dominated first by the ±1 skill
  /// band (C1); 'custom' proposes empty seats and lets the host fill them by
  /// hand (see server/src/sessions/session-mode.ts and pairing-teams.ts).
  mode          String          @default("variety")
  /// Per-court doubles/singles setting, JSON-encoded ('doubles' | 'singles')[],
  /// index 0 = court 1. Null, missing, or an unrecognised entry all read as
  /// 'doubles' — see server/src/sessions/court-formats.ts, the only place
  /// this column is parsed or written. Deliberately NOT trimmed when
  /// courtCount shrinks, so a host who drops to fewer courts and grows back
  /// finds their earlier choice restored — readers must index by court
  /// number, never read `.length` as a court count.
  courtFormats  String?
  /// Per-court pairing mode, JSON-encoded (SessionMode)[], index 0 = court 1.
  /// Read only while `mode` is 'custom' — see
  /// server/src/sessions/session-mode.ts's effectiveCourtMode and
  /// court-modes.ts, the only place this column is parsed or written. Null,
  /// missing, or an unrecognised entry all read as 'custom', so a court a
  /// host has never touched keeps proposing empty seats. Same
  /// not-trimmed-on-shrink convention as courtFormats.
  courtModes    String?
  /// Per-court display name override, JSON-encoded (string | null)[], index
  /// 0 = court 1. Null/missing/invalid entries display the 1-based number.
  /// Presentation only — Pairing.courtNumber stays the identity. Parsed and
  /// written only by server/src/sessions/court-labels.ts; same
  /// not-trimmed-on-shrink convention as courtFormats.
  courtLabels   String?
  /// Snapshot of Group.shuttleToolsEnabled at creation. A session created with
  /// it on keeps numbered shuttle tracking even if the group later switches it
  /// off; older sessions read false and never convert retroactively.
  shuttleToolsEnabled Boolean @default(false)
  /// Snapshot of Group.crossSessionHistory at creation: whether this session's
  /// pairing history reads every earlier session (true) or only itself.
  crossSessionHistory Boolean @default(false)
  /// Total shuttlecocks used tonight, counted by the host at the end (not
  /// per-match) and correctable afterwards. Null means "not recorded yet",
  /// distinct from 0. Set only via SessionsService.setShuttleDetails, never
  /// at creation. See shuttlePriceSatang.
  shuttleCount        Int?
  /// Price per shuttlecock in satang (1 THB = 100 satang) — a plain integer,
  /// no currency conversion here (that's the frontend's job). Null means
  /// "not recorded yet", distinct from 0. Set only via
  /// SessionsService.setShuttleDetails, never at creation.
  shuttlePriceSatang  Int?
  /// C3 bill inputs as JSON (model, rates, toggles, host/walk-in fee,
  /// rounding, added/removed/overridden people). Never the bill itself —
  /// that is recomputed on every read. Parsed and written only in
  /// server/src/sessions/bill-config.ts. Null = never saved.
  billConfig          String?
  /// JSON-encoded string[] of this group's PlayerRule ids switched off for
  /// this session only. Null or "[]" = none disabled; a malformed non-null
  /// value is invalid session state, never "ignore the rules". Parsed only
  /// in server/src/sessions/session-rules.ts.
  disabledRuleIds     String?         @default("[]")
  group         Group           @relation(fields: [groupId], references: [code])
  roster        SessionRoster[]
  waitlist      Waitlist[]
  pairings      Pairing[]
  creation      SessionCreation?
  shuttles      SessionShuttle[]
  checkouts     SessionCheckout[]
}

model SessionRoster {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String
  /// Whether this player is available for court fills tonight. A no-show, an
  /// early leaver, or someone resting a few rounds is set false and back to
  /// true when they return. It lives here rather than on Player because it is
  /// a fact about this session, not about the person.
  active    Boolean @default(true)
  /// Games credited to this player for rotation fairness only, never shown.
  /// Someone re-enabled part-way through would otherwise sit on zero games
  /// while everyone else is on five, and win every draw until they caught up.
  /// See SessionsService.setRosterActive.
  gamesOffset Int   @default(0)
  /// When this player last became available. Their wait is measured from here
  /// rather than from the start of the session, so someone who arrived an hour
  /// late is not credited with an hour of waiting they did not do.
  activatedAt DateTime?
  /// Walk-in / late registrant tonight (C3 D7): pays the walk-in surcharge,
  /// which is handed back to the group as a discount. Set automatically when
  /// added mid-session (addWalkIn); the host can toggle it from the bill.
  walkIn    Boolean @default(false)
  session   Session @relation(fields: [sessionId], references: [code])
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
}

model Waitlist {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String
  position  Int
  session   Session @relation(fields: [sessionId], references: [code])
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
}

model Pairing {
  id          String    @id @default(cuid())
  sessionId   String
  courtNumber Int
  matchNumber Int
  /// JSON-encoded [playerId | null, playerId | null] — a `null` entry is an
  /// unfilled seat, possible only while `confirmedAt` is null (a custom-mode
  /// draft the host hasn't finished seating). Always parse through
  /// server/src/sessions/pairing-teams.ts rather than JSON.parse directly.
  teamA       String
  /// See teamA.
  teamB       String
  scoreA      Int?
  scoreB      Int?
  winner      String? // 'A' | 'B'
  /// Incremented by every mutation so stale admin tabs cannot confirm or
  /// finish a proposal that has since been changed.
  revision    Int       @default(0)
  /// When this pending pairing last changed. The auto-confirm sweep counts
  /// 60s from here, and backdates `confirmedAt` to 30s after it — see
  /// docs/superpowers/specs/2026-09-22-auto-confirm-pending-match-design.md.
  /// Null means auto-confirm is off: a row from before this column existed,
  /// or one an undone confirm just cleared.
  pendingSince DateTime?
  /// JSON-encoded array of every doubles split this exact pending court has
  /// already shown (oldest first), reshuffle over reshuffle — not just the
  /// one currently displayed. Passed back to the engine's `avoidSplit` on
  /// the next reshuffle so a host who keeps tapping it exhausts every split
  /// before any of them repeats (G3, docs/2026-09-21-feature-review-and-roadmap.md).
  /// Reset to "[]" whenever a fresh pending pairing is created (a new match,
  /// or a custom-mode court cleared back to empty seats).
  shownSplits String    @default("[]")
  confirmedAt DateTime?
  endedAt     DateTime?
  /// JSON-encoded { playerId, partnerId: string | null }[] snapshotted at
  /// confirmation for every tagged player with an enabled must-pair link:
  /// partnerId is set only when that game counted as their carry. "[]" for
  /// legacy rows and unlinked games. Cleared on undo of confirm. See
  /// server/src/sessions/carry-outcomes.ts.
  carryOutcomes String  @default("[]")
  /// Explicit known/unknown marker for the game's shuttle log. False for every
  /// legacy and ordinary-session game (unknown — never backfilled); true once an
  /// advanced-session game is confirmed, even if later corrected to no uses
  /// (known zero). Cleared on undo of confirm. See shuttle-tracking.ts.
  shuttleLogKnown Boolean @default(false)
  /// The shuttle this game last had in hand. While the match is active it is
  /// the court's current shuttle (at most one, never shared by two active
  /// courts); after finish it is the court's next-game suggestion.
  lastShuttleId String?
  lastShuttle SessionShuttle? @relation("LastShuttle", fields: [lastShuttleId], references: [id])
  shuttleUses PairingShuttleUse[]
  session     Session   @relation(fields: [sessionId], references: [code])
}

/// A host pair rule within one group (host-feedback C). playerAId < playerBId
/// always, so one pair has one row regardless of the order it was entered.
/// kind: 'must-pair' | 'never-teammates' | 'never-same-court'
/// (engines/pair-rules.ts). Host-only — never in a @Public response.
model PlayerRule {
  id        String   @id @default(cuid())
  groupId   String
  playerAId String
  playerBId String
  kind      String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [code])
  playerA   Player   @relation("PlayerRuleA", fields: [playerAId], references: [id])
  playerB   Player   @relation("PlayerRuleB", fields: [playerBId], references: [id])

  @@unique([groupId, playerAId, playerBId])
}

model SessionCreation {
  groupId        String
  idempotencyKey String
  sessionId      String @unique
  createdAt      DateTime @default(now())
  group          Group @relation(fields: [groupId], references: [code], onDelete: Cascade)
  session        Session @relation(fields: [sessionId], references: [code], onDelete: Cascade)

  @@id([groupId, idempotencyKey])
}

/// One physical shuttle in one session (host feedback D). `number` is the
/// monotonic display number, unique within the session and never reassigned,
/// not even after the identity is voided as a mistake (voidedAt is a logical
/// delete). `usable` false means retired: it stays in historical use and can
/// be restored.
model SessionShuttle {
  id        String   @id @default(cuid())
  sessionId String
  number    Int
  usable    Boolean  @default(true)
  voidedAt  DateTime?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [code])
  uses      PairingShuttleUse[]
  lastFor   Pairing[] @relation("LastShuttle")

  @@unique([sessionId, number])
}

/// Which shuttles a game used. Unique per pairing/shuttle: going back to the
/// same shuttle within one game is still a single use.
model PairingShuttleUse {
  pairingId String
  shuttleId String
  pairing   Pairing        @relation(fields: [pairingId], references: [id])
  shuttle   SessionShuttle @relation(fields: [shuttleId], references: [id])

  @@id([pairingId, shuttleId])
}

/// A frozen early-leaver settlement (host feedback E). Money lives here, never
/// on SessionRoster: `active=false` means rested OR checked out, so only an
/// entry with `undoneAt` null counts as a settlement. An undone entry is kept
/// as an audit trail, so a player may have several rows over a night.
/// `breakdown` and `snapshot` are JSON parsed only by checkout-pricing.ts;
/// `amountSatang` is the integer amount quoted and never recomputed.
model SessionCheckout {
  id             String    @id @default(cuid())
  sessionId      String
  playerId       String
  model          String // 'perGame' | 'perShuttle' | 'buffet'
  amountSatang   Int
  breakdown      String
  snapshot       String
  settledAt      DateTime  @default(now())
  undoneAt       DateTime?
  idempotencyKey String
  session        Session   @relation(fields: [sessionId], references: [code])
  player         Player    @relation(fields: [playerId], references: [id])

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, playerId])
}
