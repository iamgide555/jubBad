datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Group {
  code      String    @id
  name      String?
  createdAt DateTime  @default(now())
  /// Nullable by necessity, not by design: this column cannot be backfilled in
  /// the migration itself, because the admin account it points at does not
  /// exist until password hashing runs in application code. AuthBootstrapService
  /// fills every null on every boot, so in a running app this is never actually
  /// null — a future reader should not "fix" this to NOT NULL, which would
  /// break a fresh deploy before the first boot has run.
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id])
  players   Player[]
  sessions  Session[]
  sessionCreations SessionCreation[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// 'admin' sees and manages every user and group; 'host' sees only the
  /// groups they own. See OwnershipGuard and the /admin module.
  role         String   @default("host")
  disabled     Boolean  @default(false)
  /// Bumped on disable, password change and password reset. The session
  /// cookie carries the version it was issued at; a mismatch is a 401. This is
  /// what makes revocation per-user instead of all-or-nothing — without it a
  /// disabled user's phone would keep working for the cookie's full 30 days.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  groups       Group[]
  resets       PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token, never the token itself — the raw value travels
  /// through a LINE chat by hand and lives in that scrollback indefinitely,
  /// the same reasoning that keeps passwords hashed rather than stored plain.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Records that a locked-out host asked for a reset, from the one page they
/// can still reach with no cookie at all. Deliberately inert: it grants
/// nothing by itself, and never reveals whether the email belongs to an
/// account — see AuthController#forgotPassword. An admin turns a request into
/// an actual PasswordReset by hand.
model PasswordResetRequest {
  id        String    @id @default(cuid())
  /// The email as typed, not a User relation: the request is recorded whether
  /// or not it matches an account, so a host's own typo is still visible to
  /// the admin rather than silently discarded.
  email     String
  createdAt DateTime  @default(now())
  handledAt DateTime?
  /// The handling admin's id as a plain string, not a relation, so this
  /// remains legible after that admin's own account is deleted.
  handledBy String?
}

model Player {
  id      String @id @default(cuid())
  groupId String
  name    String
  aliases String // JSON-encoded string[]
  age     Int?
  email   String?
  phone   String?
  /// Skill level (ระดับมือ): one of engines/levels.ts's LEVELS, or null when
  /// unset. Seeds this player's starting Elo (see engines/levels.ts seedFor)
  /// and is compared under the ±1 band when Session.mode is 'level'.
  /// Host-only — never included in a @Public response.
  level      String?
  /// When this level last changed. `null` means "from the start" for a
  /// legacy row or a level set before the player's first match.
  levelSetAt DateTime?
  group      Group  @relation(fields: [groupId], references: [code])
  rosterEntries SessionRoster[]
  waitlistEntries Waitlist[]
}

model Session {
  code          String          @id
  groupId       String
  date          String?
  venue         String?
  courtCount    Int?
  rawImportText String
  createdAt     DateTime        @default(now())
  endedAt       DateTime?
  /// 'variety' (default) spreads partners and opponents; 'balanced' also
  /// pulls the two sides of each match together on Elo rating; 'level'
  /// spreads partners like 'variety' but dominated first by the ±1 skill
  /// band (C1); 'custom' proposes empty seats and lets the host fill them by
  /// hand (see server/src/sessions/session-mode.ts and pairing-teams.ts).
  mode          String          @default("variety")
  /// Per-court doubles/singles setting, JSON-encoded ('doubles' | 'singles')[],
  /// index 0 = court 1. Null, missing, or an unrecognised entry all read as
  /// 'doubles' — see server/src/sessions/court-formats.ts, the only place
  /// this column is parsed or written. Deliberately NOT trimmed when
  /// courtCount shrinks, so a host who drops to fewer courts and grows back
  /// finds their earlier choice restored — readers must index by court
  /// number, never read `.length` as a court count.
  courtFormats  String?
  /// Total shuttlecocks used tonight, counted by the host at the end (not
  /// per-match) and correctable afterwards. Null means "not recorded yet",
  /// distinct from 0. Set only via SessionsService.setShuttleDetails, never
  /// at creation. See shuttlePriceSatang.
  shuttleCount        Int?
  /// Price per shuttlecock in satang (1 THB = 100 satang) — a plain integer,
  /// no currency conversion here (that's the frontend's job). Null means
  /// "not recorded yet", distinct from 0. Set only via
  /// SessionsService.setShuttleDetails, never at creation.
  shuttlePriceSatang  Int?
  /// C3 bill inputs as JSON (model, rates, toggles, host/walk-in fee,
  /// rounding, added/removed/overridden people). Never the bill itself —
  /// that is recomputed on every read. Parsed and written only in
  /// server/src/sessions/bill-config.ts. Null = never saved.
  billConfig          String?
  group         Group           @relation(fields: [groupId], references: [code])
  roster        SessionRoster[]
  waitlist      Waitlist[]
  pairings      Pairing[]
  creation      SessionCreation?
}

model SessionRoster {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String
  /// Whether this player is available for court fills tonight. A no-show, an
  /// early leaver, or someone resting a few rounds is set false and back to
  /// true when they return. It lives here rather than on Player because it is
  /// a fact about this session, not about the person.
  active    Boolean @default(true)
  /// Games credited to this player for rotation fairness only, never shown.
  /// Someone re-enabled part-way through would otherwise sit on zero games
  /// while everyone else is on five, and win every draw until they caught up.
  /// See SessionsService.setRosterActive.
  gamesOffset Int   @default(0)
  /// When this player last became available. Their wait is measured from here
  /// rather than from the start of the session, so someone who arrived an hour
  /// late is not credited with an hour of waiting they did not do.
  activatedAt DateTime?
  /// Walk-in / late registrant tonight (C3 D7): pays the walk-in surcharge,
  /// which is handed back to the group as a discount. Set automatically when
  /// added mid-session (addWalkIn); the host can toggle it from the bill.
  walkIn    Boolean @default(false)
  session   Session @relation(fields: [sessionId], references: [code])
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
}

model Waitlist {
  id        String  @id @default(cuid())
  sessionId String
  playerId  String
  position  Int
  session   Session @relation(fields: [sessionId], references: [code])
  player    Player  @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
}

model Pairing {
  id          String    @id @default(cuid())
  sessionId   String
  courtNumber Int
  matchNumber Int
  /// JSON-encoded [playerId | null, playerId | null] — a `null` entry is an
  /// unfilled seat, possible only while `confirmedAt` is null (a custom-mode
  /// draft the host hasn't finished seating). Always parse through
  /// server/src/sessions/pairing-teams.ts rather than JSON.parse directly.
  teamA       String
  /// See teamA.
  teamB       String
  scoreA      Int?
  scoreB      Int?
  winner      String? // 'A' | 'B'
  /// Incremented by every mutation so stale admin tabs cannot confirm or
  /// finish a proposal that has since been changed.
  revision    Int       @default(0)
  /// When this pending pairing last changed. The auto-confirm sweep counts
  /// 60s from here, and backdates `confirmedAt` to 30s after it — see
  /// docs/superpowers/specs/2026-09-22-auto-confirm-pending-match-design.md.
  /// Null means auto-confirm is off: a row from before this column existed,
  /// or one an undone confirm just cleared.
  pendingSince DateTime?
  confirmedAt DateTime?
  endedAt     DateTime?
  session     Session   @relation(fields: [sessionId], references: [code])
}

model SessionCreation {
  groupId        String
  idempotencyKey String
  sessionId      String @unique
  createdAt      DateTime @default(now())
  group          Group @relation(fields: [groupId], references: [code], onDelete: Cascade)
  session        Session @relation(fields: [sessionId], references: [code], onDelete: Cascade)

  @@id([groupId, idempotencyKey])
}
